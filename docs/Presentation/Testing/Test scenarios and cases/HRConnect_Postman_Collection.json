          "raw": "{\n  \"employeeId\": 1,\n  \"leaveType\": \"Vacation\",\n  \"startDate\": \"2025-07-01T00:00:00\",\n  \"endDate\": \"2025-07-02T00:00:00\",\n  \"reason\": \"Testing leave\"\n}"
        },
        "url": {
